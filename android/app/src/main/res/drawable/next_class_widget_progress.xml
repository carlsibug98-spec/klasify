<?xml version="1.0" encoding="utf-8"?>
<!-- 6dp rounded track with the board's orange gradient fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/next_class_widget_track" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient
                    android:angle="0"
                    android:endColor="@color/next_class_widget_progress_end"
                    android:startColor="@color/next_class_widget_live" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>

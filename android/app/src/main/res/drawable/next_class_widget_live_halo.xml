<?xml version="1.0" encoding="utf-8"?>
<!-- Live dot with the board's 3dp 22% halo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="14dp"
        android:height="14dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/next_class_widget_live_halo" />
        </shape>
    </item>
    <item
        android:width="8dp"
        android:height="8dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/next_class_widget_live" />
        </shape>
    </item>
</layer-list>

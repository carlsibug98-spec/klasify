<?xml version="1.0" encoding="utf-8"?>
<!--
    Klasify Upcoming home-screen widget, matching the states board.

    States:
      1. container_upcoming — "Next up" pill, room CTA, subject, a STARTS IN
         caption over the structured countdown, LATER TODAY rows, and (tall
         widgets only) the month calendar.
      2. container_inclass  — "In class" pill, room CTA, subject and the big
         hours/minutes-left countdown.
      3. container_alldone  — outline check, all-done/free-day copy, and the
         next-class shelf (day pill, starts-in, subject, time).
      4. container_active   — compact fallback for short widgets: dot status
         line plus subject.
      5. widget_empty_container — logo mark and empty copy.
    The provider drives every state; colours come from values/ and
    values-night/ so light and dark mode stay automatic.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/next_class_widget_background"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <!-- 1. Next up  -->
    <LinearLayout
        android:id="@+id/container_upcoming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_upcoming_pill"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/next_class_widget_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:text="@string/next_class_widget_label"
                android:textColor="@color/next_class_widget_pill_text"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/widget_upcoming_cta"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/next_class_widget_cta_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/next_class_widget_navigate_icon"
                    android:tint="@color/next_class_widget_cta_fg" />

                <FrameLayout
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/widget_upcoming_cta_room"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:maxWidth="110dp"
                    android:textColor="@color/next_class_widget_cta_fg"
                    android:textSize="15sp"
                    tools:text="Lab 2" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_upcoming_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:textColor="@color/next_class_widget_text"
            android:textSize="20sp"
            tools:text="Physics Lab" />

        <TextView
            android:id="@+id/widget_upcoming_starts_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.1"
            android:text="@string/next_class_widget_starts_in_label"
            android:textColor="@color/next_class_widget_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="3dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_upcoming_value_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:textColor="@color/next_class_widget_text"
                android:textSize="44sp"
                android:textStyle="bold"
                tools:text="1" />

            <TextView
                android:id="@+id/widget_upcoming_unit_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="10dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingBottom="6dp"
                android:textColor="@color/next_class_widget_unit"
                android:textSize="15sp"
                tools:text="h" />

            <TextView
                android:id="@+id/widget_upcoming_value_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:textColor="@color/next_class_widget_text"
                android:textSize="44sp"
                android:textStyle="bold"
                tools:text="25" />

            <TextView
                android:id="@+id/widget_upcoming_unit_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingBottom="6dp"
                android:textColor="@color/next_class_widget_unit"
                android:textSize="15sp"
                tools:text="min" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_upcoming_later_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.1"
            android:text="@string/next_class_widget_later_today"
            android:textColor="@color/next_class_widget_muted"
            android:textSize="11sp" />

        <FrameLayout
            android:id="@+id/widget_later_divider_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/next_class_widget_divider" />

        <LinearLayout
            android:id="@+id/widget_later_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/widget_later_time_1"
                android:layout_width="78dp"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/next_class_widget_later_time"
                android:textSize="15sp"
                tools:text="3:00 PM" />

            <TextView
                android:id="@+id/widget_later_subject_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/next_class_widget_text"
                android:textSize="15sp"
                tools:text="Data Structures" />

            <TextView
                android:id="@+id/widget_later_room_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="110dp"
                android:textColor="@color/next_class_widget_room"
                android:textSize="12sp"
                tools:text="Class 242-B" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_later_divider_2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/next_class_widget_divider" />

        <LinearLayout
            android:id="@+id/widget_later_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/widget_later_time_2"
                android:layout_width="78dp"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/next_class_widget_later_time"
                android:textSize="15sp"
                tools:text="4:30 PM" />

            <TextView
                android:id="@+id/widget_later_subject_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/next_class_widget_text"
                android:textSize="15sp"
                tools:text="English Lit" />

            <TextView
                android:id="@+id/widget_later_room_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="110dp"
                android:textColor="@color/next_class_widget_room"
                android:textSize="12sp"
                tools:text="Class 118" />
        </LinearLayout>

        <include
            android:id="@+id/widget_cal_section"
            layout="@layout/widget_next_class_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp" />
    </LinearLayout>

    <!-- 2. In class  -->
    <LinearLayout
        android:id="@+id/container_inclass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_inclass_pill"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/next_class_widget_pill"
                android:drawableStart="@drawable/next_class_widget_live_halo"
                android:drawablePadding="8dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:text="@string/next_class_widget_in_class"
                android:textColor="@color/next_class_widget_pill_text"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/widget_inclass_cta"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/next_class_widget_cta_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/next_class_widget_navigate_icon"
                    android:tint="@color/next_class_widget_cta_fg" />

                <FrameLayout
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/widget_inclass_cta_room"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:maxWidth="110dp"
                    android:textColor="@color/next_class_widget_cta_fg"
                    android:textSize="15sp"
                    tools:text="304" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_inclass_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:textColor="@color/next_class_widget_text"
            android:textSize="20sp"
            tools:text="Advanced Mathematics" />

        <TextView
            android:id="@+id/widget_inclass_ends_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.1"
            android:text="@string/next_class_widget_ends_in_label"
            android:textColor="@color/next_class_widget_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="3dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_inclass_value_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:textColor="@color/next_class_widget_text"
                android:textSize="44sp"
                android:textStyle="bold"
                tools:text="1" />

            <TextView
                android:id="@+id/widget_inclass_unit_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="10dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingBottom="6dp"
                android:textColor="@color/next_class_widget_unit"
                android:textSize="15sp"
                tools:text="h" />

            <TextView
                android:id="@+id/widget_inclass_value_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:textColor="@color/next_class_widget_text"
                android:textSize="44sp"
                android:textStyle="bold"
                tools:text="30" />

            <TextView
                android:id="@+id/widget_inclass_unit_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingBottom="6dp"
                android:textColor="@color/next_class_widget_unit"
                android:textSize="15sp"
                tools:text="min left" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. All done  -->
    <LinearLayout
        android:id="@+id/container_alldone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Absorbs spare height so a short card (no shelf) centres the
             message instead of leaving a dead band under it. Collapses to
             zero as soon as the header + shelf need the room. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/next_class_widget_check_icon"
                android:tint="@color/next_class_widget_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_alldone_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.01"
                    android:maxLines="2"
                    android:text="@string/next_class_widget_all_done_title"
                    android:textColor="@color/next_class_widget_text"
                    android:textSize="19sp"
                    tools:text="All done for today" />

                <TextView
                    android:id="@+id/widget_alldone_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="@color/next_class_widget_meta"
                    android:textSize="13sp"
                    tools:text="Enjoy the rest of your Tuesday." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_alldone_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/next_class_widget_shelf_background"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_alldone_day_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:background="@drawable/next_class_widget_day_pill"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:textColor="@color/next_class_widget_day_pill_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="TOMORROW" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/widget_alldone_starts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/next_class_widget_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Starts in 16h 30m" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_alldone_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:textColor="@color/next_class_widget_text"
                android:textSize="16sp"
                tools:text="Chemistry" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/next_class_widget_clock_icon"
                    android:tint="@color/next_class_widget_meta_icon" />

                <TextView
                    android:id="@+id/widget_alldone_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/next_class_widget_meta"
                    android:textSize="13sp"
                    tools:text="8:30 – 10:00 AM" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 4. Compact fallback  -->
    <LinearLayout
        android:id="@+id/container_active"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/next_class_widget_live_halo" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/next_class_widget_compact_text"
                android:textSize="13sp"
                tools:text="In class · ends in 24m" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:textColor="@color/next_class_widget_text"
            android:textSize="18sp"
            tools:text="Advanced Mathematics" />
    </LinearLayout>

    <!-- 5. Empty  -->
    <LinearLayout
        android:id="@+id/widget_empty_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/next_class_widget_logo_tile"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/next_class_widget_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/next_class_widget_empty_title"
                android:textColor="@color/next_class_widget_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_empty_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/next_class_widget_empty_message"
                android:textColor="@color/next_class_widget_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

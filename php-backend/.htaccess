# Klasify API (PHP). Every request that is not a real file goes to index.php,
# which does the routing. Requires mod_rewrite (enabled by default in XAMPP).
Options -Indexes
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# CGI/FastCGI hosts drop the Authorization header; pass it through.
# mod_php under XAMPP works without this, but hosts don't always.
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Never serve the configuration file directly.
<Files "config.php">
    Require all denied
</Files>
